# ==============================================================================
# OmniRoute Production Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=20128
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. SECURITY & ACCESS CONTROL (CRITICAL)
# ------------------------------------------------------------------------------
# Set to 'true' so anonymous WAN requests cannot drain your upstream AI credits.
REQUIRE_API_KEY=true

# 64-character hex secrets for encrypting keys and signing JWT session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_secure_random_64_character_hex_string_generate_with_crypto
API_KEY_SECRET=change_me_to_a_secure_random_64_character_hex_string_generate_with_crypto

# ------------------------------------------------------------------------------
# 2. PERSISTENCE (SQLite Database)
# ------------------------------------------------------------------------------
# Path where storage.sqlite and migrations reside.
# Must be mapped to a persistent volume when running inside Docker / containers.
DATA_DIR=/root/.omniroute

# ------------------------------------------------------------------------------
# 3. PUBLIC APP URL & BRANDING (SEO & Social Sharing)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-omniroute-domain.com

# ------------------------------------------------------------------------------
# 4. OPTIONAL UPSTREAM DEFAULTS
# ------------------------------------------------------------------------------
# You can also configure keys securely inside the OmniRoute Web Dashboard.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
